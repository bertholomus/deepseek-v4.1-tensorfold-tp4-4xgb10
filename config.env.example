# Site settings for scripts/serve.sh. Copy to config.env (next to this file) or point DSV41_CONFIG at a copy.
# Sourced by bash: plain VAR=value lines. Every <PLACEHOLDER> must be replaced; the script refuses to start while one
# is left.

# --- the four nodes, rank 0 first (ranks 0-1 and 2-3 are the 2D split's two pairs) ----------------------------------
NODES="<NODE0_SSH> <NODE1_SSH> <NODE2_SSH> <NODE3_SSH>"   # ssh aliases, each without a password prompt
MASTER_IP="<NODE0_LINK_IP>"       # rank 0's address on the RoCE link
TP_PORT=29760                     # rank 0's rendezvous port (unauthenticated: keep it on the private link)
RDMA_HCA="<RDMA_DEV0>,<RDMA_DEV1>"  # the link's RDMA devices (ibv_devices), the same names on every node
NET_IF="<LINK_IFNAME>"            # NCCL's socket interface on the link

# --- paths, the same on every node ------------------------------------------------------------------------------------
MODEL_DIR="<MODEL_DIR>"           # Mia-AiLab/DeepSeek-V4.1-Flash-EXL3-2.9bpw
ENGRAM_DIR="<ENGRAM_DIR>"         # DeepSeek's original shards with the Engram tables (shards 47 and 48)
ENGINE_DIR="<ENGINE_DIR>"         # tensorfold-native, tf-dsv41-lanes and rdma_gather.fatbin from the engine build
KIT_DIR="<KIT_DIR>"               # the kernel kit: aot/, cubins/, rope-*.f32, rope.json, engram.json, vision/
CACHE_DIR="<CACHE_DIR>"           # holds rank-cache/ (each rank's weight file) and dsv41_token_map.json
LOG_DIR="<LOG_DIR>"
IMAGE=nvcr.io/nvidia/pytorch:26.07-py3

# --- HTTP on rank 0 ---------------------------------------------------------------------------------------------------
HOST=127.0.0.1                    # 0.0.0.0 serves the network: then also pass --api-key-file (SERVER_FLAGS)
PORT=18091
SERVED_NAME=DeepSeek-V4.1-Flash-TP4
SERVER_FLAGS="--thinking --max-tokens 32768 --temperature 1.0 --top-p 0.95 --top-k 20"

# --- the served settings, as measured in README.md --------------------------------------------------------------------
CONTEXT=1048576                   # a request's positions at most
WINDOW=2097152                    # the streams' shared positions
PARALLEL=16
ENGINE_ENV="TF_DS_2D_GU=parity TF_DS_ROUND_ROWS=48 TF_DS_STREAMS=16 TF_DS_SERVED_K=solo TF_DS_WINDOW=2097152 TF_DS_ROUND_MS=14.5,17.4,19.9,22.3,24.0,25.9,27.2,28.5,29.9,31.2,32.5,33.8,35.2,36.5,37.8,39.2,40.5,41.8,43.2,44.5,45.8,47.1,48.5,49.8,51.1,52.5,53.8,55.1,56.5,57.8,59.1,60.4,61.8,63.1,64.4,65.8,67.1,68.4,69.8,71.1,72.4,73.7,75.1,76.4,77.7,79.1,80.4,81.7"
FOLLOW_FLAGS="--round-rows 48 --streams 16 --pool 2097152 --context 1048576"
